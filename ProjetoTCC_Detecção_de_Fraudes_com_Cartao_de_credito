import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    confusion_matrix,
    classification_report,
    roc_auc_score,
    roc_curve,
    precision_recall_curve,
    average_precision_score
)

from sklearn.preprocessing import StandardScaler
from xgboost import XGBClassifier

# In[ 2. CARREGAR DATASET ]

df = pd.read_csv('creditcard.csv')

print("Dimensão do dataset:", df.shape)
print("\nDistribuição da variável target:")
print(df['Class'].value_counts())
print("\nProporção:")
print(df['Class'].value_counts(normalize=True))


# In[ 3. SEPARAR VARIÁVEIS ]

X = df.drop('Class', axis=1)
y = df['Class']


# In[ 4. TRAIN / TEST SPLIT ]

X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.3,
    random_state=42,
    stratify=y
)

# In[ 4.1. PADRONIZAÇÃO ]

scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# In[ 5. AJUSTE DO DESBALANCEAMENTO ]

# scale_pos_weight = (negativos / positivos)
neg = y_train.value_counts()[0]
pos = y_train.value_counts()[1]
scale_pos_weight = neg / pos

print(f"\nScale_pos_weight: {scale_pos_weight:.2f}")

# In[ 6. MODELO - XGBOOST ]

model = XGBClassifier(
    n_estimators=300,
    max_depth=6,
    learning_rate=0.1,
    subsample=0.8,
    colsample_bytree=0.8,
    scale_pos_weight=scale_pos_weight,
    random_state=42,
    n_jobs=-1,
    eval_metric='logloss',
    use_label_encoder=False
)

model.fit(X_train_scaled, y_train)

# In[ 7. PREDIÇÕES ]

y_pred = model.predict(X_test_scaled)  # threshold padrão (0.5)
y_proba = model.predict_proba(X_test_scaled)[:, 1]


# In[ 8. MÉTRICAS ]

print("\n===== Classification Report (Threshold = 0.5) =====")
print(classification_report(y_test, y_pred))

roc_auc = roc_auc_score(y_test, y_proba)
pr_auc = average_precision_score(y_test, y_proba)

print(f"\nROC-AUC: {roc_auc:.2f}")
print(f"PR-AUC: {pr_auc:.2f}")


# In[ 9. MATRIZ DE CONFUSÃO ]

cm = confusion_matrix(y_test, y_pred)

plt.figure(figsize=(6,5))
ax = sns.heatmap(
    cm,
    annot=True,
    fmt='d',
    cmap='Greys',
    cbar=True
    )

plt.title('XGBoost (Treshold padrão)')
plt.xlabel('Predito')
plt.ylabel('Real')

ax.set_xticklabels(['Legítima','Fraude'])
ax.set_yticklabels(['Legítima','Fraude'])
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)
ax.spines['left'].set_visible(True)
ax.spines['bottom'].set_visible(True)
ax.spines['left'].set_linewidth(1.5)
ax.spines['bottom'].set_linewidth(1.5)
ax.spines['left'].set_color('black')
ax.spines['bottom'].set_color('black')

plt.tight_layout()
plt.show()

# In[ 9. CURVA ROC ]

fpr, tpr, _ = roc_curve(y_test, y_proba)

plt.figure(figsize=(6,5))
plt.plot(fpr, tpr, label=f'ROC AUC = {roc_auc:.2f}')
plt.plot([0,1], [0,1], linestyle='--')
plt.xlabel('FPR', fontsize=16)
plt.ylabel('TPR', fontsize=16)
plt.title('XGBoost', fontsize=18)
plt.legend(fontsize=14)
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.show()

# In[ 11. CURVA PRECISION-RECALL ]

precision, recall, thresholds = precision_recall_curve(y_test, y_proba)

plt.figure(figsize=(6,5))
plt.plot(recall, precision, label=f'PR AUC = {pr_auc:.2f}')
plt.xlabel('Sensibilidade',fontsize=16)
plt.ylabel('Precisão',fontsize=16)
plt.title('XGBoost',fontsize=18)
plt.legend(fontsize=14)
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.show()


# In[ 11.1 AJUSTE DE THRESHOLD ]

# calcular F1 para cada threshold
f1_scores = 2 * (precision * recall) / (precision + recall + 1e-10)

# encontrar melhor índice (ignorar último ponto)
best_idx = np.argmax(f1_scores[:-1])

best_threshold = thresholds[best_idx]

print(f"\nMelhor Threshold: {best_threshold:.2f}")
print(f"Precision: {precision[best_idx]:.2f}")
print(f"Recall: {recall[best_idx]:.2f}")
print(f"F1-Score: {f1_scores[best_idx]:.2f}")

# In[ 11.2 NOVAS PREDIÇÕES ]

y_pred_adjusted = (y_proba >= best_threshold).astype(int)


# In[ 11.3 MÉTRICAS AJUSTADAS ]

print("\n===== Classification Report (Threshold Ajustado) =====")
print(classification_report(y_test, y_pred_adjusted))


# In[ 11.4 MATRIZ DE CONFUSÃO AJUSTADA ]

cm_adj = confusion_matrix(y_test, y_pred_adjusted)
